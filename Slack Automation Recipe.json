    {
      "parameters": {
        "jsCode": "const slackData = $('Slack Trigger').first().json;\n\n// 1. Ignore bot messages (prevents loops)\nconst isBot = slackData.event?.bot_id || slackData.bot_id || slackData.event?.subtype === 'bot_message';\nif (isBot) {\n  return [];\n}\n\n// 2. Ignore past messages older than 2 minutes\nconst messageTs = parseFloat(slackData.event?.ts || slackData.ts || 0);\nconst nowInSeconds = Date.now() / 1000;\nif (messageTs && (nowInSeconds - messageTs > 120)) {\n  return [];\n}\n\n// 3. Format message\nconst editData = $('Edit Fields').first().json;\nconst channel = editData.channel_id || slackData.event?.channel || slackData.channel;\nconst aiResponse = $input.first().json.text;\n\nreturn {\n  json: {\n    channel_id: channel,\n    formatted_message: `${aiResponse}\\n\\n🍽️ _மகிழ்ச்சியாக சமைத்து ருசித்து மகிழுங்கள்!_ 😋✨`\n  }\n};"
      },
